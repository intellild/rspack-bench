{
  "name": "rspack-css-loader-bench",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "zx cases/react-css/bench.mjs",
    "smoke": "zx cases/react-css/bench.mjs --modules 24 --runs 1 --supplement always",
    "smoke:css": "zx cases/react-css/bench.mjs --styles css --modules 24 --runs 1 --supplement always",
    "generate": "zx cases/react-css/bench.mjs --generate-only",
    "smoke:mixed": "zx cases/react-css/bench.mjs --experiment mixed --modules 24 --runs 1",
    "bench:loader-hook": "zx cases/loader-hook/bench.mjs",
    "smoke:loader-hook": "zx cases/loader-hook/bench.mjs --modules 24 --runs 1",
    "bench:noop-loader": "zx cases/noop-loader/bench.mjs",
    "bench:babel-loader": "zx cases/babel-loader/bench.mjs",
    "bench:less-loader": "zx cases/less-loader/bench.mjs",
    "bench:split-chunks-name": "zx cases/split-chunks-name/bench.mjs",
    "bench:babel-loader-parallel-cache": "zx cases/babel-loader-parallel-cache/bench.mjs"
  },
  "devDependencies": {
    "zx": "8.8.5",
    "react": "19.1.0"
  },
  "packageManager": "pnpm@10.12.4"
}
